// Max attainable order dimension of a fully frontier-synchronized execution,
// as a function of N (number of processes). Climbs far slower than the
// vector-clock ceiling of N: a new dimension first appears at N = 1 + C(d,2),
// i.e. at N = 2, 4, 7, (conjectured) 11.
digraph dimvn {
  rankdir=LR;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12];
  edge [arrowhead=vee, fontname="Helvetica", fontsize=10];

  n2  [label="N = 2,3\nmax dim 2\n(first dim 2 at N=2)",      fillcolor="#dff0d8"];
  n4  [label="N = 4,5,6\nmax dim 3\n(first dim 3 at N=4)",    fillcolor="#fcf8e3"];
  n7  [label="N = 7,8,9,10\nmax dim 4\n(first dim 4 at N=7)", fillcolor="#f2dede"];
  n11 [label="N = 11 ?\ndim 5 ?\n(conjectured, UNCONFIRMED)", fillcolor="#e8e0f5", style="rounded,filled,dashed"];

  n2 -> n4  [label="  +1 dim"];
  n4 -> n7  [label="  +1 dim"];
  n7 -> n11 [label="  +1 dim ?", style=dashed];

  law [label="first appearance at N = 1 + d(d-1)/2  =  1, 2, 4, 7, 11, ...\nso max dimension(N)  ~  sqrt(2N),  far below the vector-clock ceiling N",
       shape=note, fillcolor="#eeeeee", fontsize=10];
}
